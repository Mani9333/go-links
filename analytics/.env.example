# Copy to .env and adjust. All values are optional with sane defaults.

HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
# development = human-readable logs; anything else = JSON logs
ENV=development

# Point at the SAME MongoDB the TypeScript service writes to.
# If unset, the service serves in-memory sample data (handy for local dev).
# MONGODB_URI=mongodb+srv://mani:<db_password>@sample-cluster.nt7uhom.mongodb.net/?appName=sample-cluster
MONGODB_URI=
MONGODB_DB=golinks
MONGODB_COLLECTION=links

# Entries returned in "top"/"recent" lists.
TOP_N=5

# Only needed for cross-origin local dev (comma-separated). Behind nginx, leave blank.
CORS_ORIGINS=
