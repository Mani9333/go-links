# Copy to .env and adjust. All values are optional and have sane defaults.

HOST=0.0.0.0
PORT=3000
# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info
# development enables pretty logs; anything else emits JSON logs
NODE_ENV=development

# --- MongoDB ---
# If MONGODB_URI is unset, the app runs on an in-memory store (data resets on
# restart) — handy for local dev. Set it to use a real database.
#
# Atlas SRV example (replace <db_password>, URL-encode any special characters):
# MONGODB_URI=mongodb+srv://mani:<db_password>@sample-cluster.nt7uhom.mongodb.net/?appName=sample-cluster
MONGODB_URI=
# Database and collection are created automatically on startup if missing.
MONGODB_DB=golinks
MONGODB_COLLECTION=links
